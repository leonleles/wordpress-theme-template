{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "create-block/new-starter-block",
  "version": "0.1.0",
  "title": "New Starter Block",
  "category": "widgets",
  "icon": "smiley",
  "description": "Example block scaffolded with Create Block tool.",
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "appearanceTools": true,
    "__experimentalBorder": {
      "radius": true,
      "__experimentalDefaultControls": {
        "radius": true
      }
    }
  },
  "attributes": {
    "items": {
      "type": "array",
      "title": {
        "type": "string"
      },
      "image": {
        "type": "object",
        "id": {
          "type": "number"
        },
        "url": {
          "type": "string"
        }
      }
    }
  },
  "textdomain": "new-starter-block",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}
